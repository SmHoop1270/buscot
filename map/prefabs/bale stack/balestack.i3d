<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="balestack.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.7"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/maps/textures/shared/snow_diffuse.dds"/>
    <File fileId="2" filename="$data/maps/textures/shared/snow_normal.dds"/>
    <File fileId="3" filename="$data/maps/textures/shared/snow_specular.png"/>
    <File fileId="11" filename="$data/shaders/buildingShader.xml"/>
    <File fileId="4" filename="$data/shaders/snowHeapShader.xml"/>
    <File fileId="10" filename="$data/shared/default_specular.dds"/>
    <File fileId="17" filename="prefabs/FS22_BaleStack_prefab/textures/belkaSlomy_diffuse.dds"/>
    <File fileId="18" filename="prefabs/FS22_BaleStack_prefab/textures/belkaSlomy_normal.dds"/>
    <File fileId="16" filename="prefabs/FS22_BaleStack_prefab/textures/plandeka01_height.dds"/>
    <File fileId="9" filename="prefabs/FS22_BaleStack_prefab/textures/plandeka01_normal.dds"/>
    <File fileId="8" filename="prefabs/FS22_BaleStack_prefab/textures/plandeka_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="belkaSlomy" materialId="5" customShaderId="11">
      <Texture fileId="17"/>
      <Normalmap fileId="18"/>
      <Glossmap fileId="10"/>
    </Material>
    <Material name="Material" materialId="6" diffuseColor="0.8 0.8 0.8 1" specularColor="0.6 1 0">
    </Material>
    <Material name="plandeka" materialId="7" customShaderId="11" customShaderVariation="customParallax">
      <Texture fileId="8"/>
      <Normalmap fileId="9"/>
      <Glossmap fileId="10"/>
      <Custommap name="mParallaxMap" fileId="16"/>
    </Material>
    <Material name="snieg" materialId="8" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="balestack.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="baleStack" nodeId="14">
      <TransformGroup name="clearAreas" nodeId="15">
        <TransformGroup name="clearArea1Start" translation="8 0 -5" nodeId="16">
          <TransformGroup name="clearArea1Width" translation="0 0 10" nodeId="17"/>
          <TransformGroup name="clearArea1Height" translation="-16 0 0" nodeId="18"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="levelAreas" nodeId="19">
        <TransformGroup name="levelArea1Start" translation="8 0 -5" nodeId="20">
          <TransformGroup name="levelArea1Width" translation="0 0 10" nodeId="21"/>
          <TransformGroup name="levelArea1Height" translation="-16 0 0" nodeId="22"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="testAreas" nodeId="23">
        <TransformGroup name="testArea1Start" translation="8 0 -5" nodeId="24">
          <TransformGroup name="testArea1End" translation="-16 5 10" nodeId="25"/>
        </TransformGroup>
      </TransformGroup>
      <TransformGroup name="balotySlomy" clipDistance="300" nodeId="26">
        <Shape name="balotySlomySnow" shapeId="1" clipDistance="150" nodeId="27" castsShadows="true" receiveShadows="true" materialIds="8"/>
        <Shape name="balotyKolizja" shapeId="2" static="true" nodeId="28" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="6"/>
        <Shape name="balotyPlandeka" shapeId="3" nodeId="29" castsShadows="true" receiveShadows="true" materialIds="7"/>
        <Shape name="balotySlomy" shapeId="4" nodeId="30" castsShadows="true" receiveShadows="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
