<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="objectStorage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_objectStorage</name>
        <functions>
            <function>$l10n_function_objectStorage</function>
        </functions>
        <image>../../textures/FS25_AddableTriggers_store_store_objectStorage.dds</image>
        <price>5000</price>
        <dailyUpkeep>5</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>storages</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>silos</tab>
        </brush>
        <vertexBufferMemoryUsage>2048</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>1024</indexBufferMemoryUsage>
        <textureMemoryUsage>65536</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>farm_objectStorage.i3d</filename>
<canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="false" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="testArea1Start" endNode="testArea1End" />
    </tipOcclusionUpdateAreas>


    <triggerMarkers>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d"   adjustToGround="true" />
        <triggerMarker node="objectTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
   </triggerMarkers>

    <hotspots>
        <hotspot type="LOADING" />
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <objectStorage supportsBales="true" supportsPallets="true" maxLength="5.5" maxWidth="6" maxHeight="5.5">
        <playerTrigger node="playerTrigger" />
        <objectTrigger node="objectTrigger" />
        <spawnAreas>
            <spawnArea startNode="spawnSpace1start" endNode="spawnSpace1end"/>
        </spawnAreas>
        <storageAreas>
            <storageArea startNode="storageAreaStart01" endNode="storageAreaEnd01"/>
        </storageAreas>
    </objectStorage>

    <!--pointOfInterest>
        <point triggerNode="objectTrigger" text="$l10n_poi_objectStorageUnload" showOwner="true"  showEveryone="false"/>
        <point triggerNode="playerTrigger" text="$l10n_poi_objectStorageLoad"   showOwner="true"  showEveryone="false" />
    </pointOfInterest-->

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="testArea1Start" endNode="testArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <i3dMappings>
        <i3dMapping id="testArea1Start" node="0>0|0" />
        <i3dMapping id="testArea1End" node="0>0|0|0" />
        <i3dMapping id="clearArea1Start" node="0>0|1" />
        <i3dMapping id="clearArea1Width" node="0>0|1|0" />
        <i3dMapping id="clearArea1Height" node="0>0|1|1" />
        <i3dMapping id="levelArea1Start" node="0>0|2" />
        <i3dMapping id="levelArea1Width" node="0>0|2|0" />
        <i3dMapping id="levelArea1Height" node="0>0|2|1" />
        <i3dMapping id="indoorArea1Start" node="0>0|3" />
        <i3dMapping id="indoorArea1Width" node="0>0|3|0" />
        <i3dMapping id="indoorArea1Height" node="0>0|3|1" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>0|4" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>0|4|0" />
        <i3dMapping id="spawnSpace1start" node="0>0|5|0|1" />
        <i3dMapping id="spawnSpace1end" node="0>0|5|0|1|0" />
        <i3dMapping id="storageAreaStart01" node="0>0|5|0|0" />
        <i3dMapping id="storageAreaEnd01" node="0>0|5|0|0|0" />
        <i3dMapping id="objectTrigger" node="0>0|5|1" />
        <i3dMapping id="objectTriggerMarker" node="0>0|5|1|0" />
        <i3dMapping id="warningStripes" node="0>0|5|1|1" />
        <i3dMapping id="warningStripes2" node="0>0|5|1|2" />
        <i3dMapping id="playerTrigger" node="0>0|5|2" />
        <i3dMapping id="playerTriggerMarker" node="0>0|5|2|0" />
        <i3dMapping id="infoTrigger" node="0>0|5|3" />
    </i3dMappings>
</placeable>
