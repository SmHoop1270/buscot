<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="wardrobe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_Bureaux_JD</name>
        <functions>
            <function>$l10n_function_farmHouse</function>
        </functions>
        <image>store/store_Bureaux_JD.png</image>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <price>243000</price>
        <lifetime>1000</lifetime>
        <dailyUpkeep>25</dailyUpkeep>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>farmhouses</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>farmhouses</tab>
        </brush>
        <vertexBufferMemoryUsage>2431744</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>726016</indexBufferMemoryUsage>
        <textureMemoryUsage>15663104</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/Bureaux_JD.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="medImp" pitchScale="1.2"/>
        </sounds>

    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="grass"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="grass"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="FARM" linkNode="0>" teleportNode="teleportNode" />
    </hotspots>

    <dynamicallyLoadedParts>
    </dynamicallyLoadedParts>

    <animatedObjects>
        <animatedObject saveId="light" >
            <animation duration="1.0">
                <part node="realLightsLow">
                    <keyFrame time="0.0" visibility="false"/>
                    <keyFrame time="0.3" visibility="true"/>
                </part>
                <part node="realLightsHigh">
                    <keyFrame time="0.0" visibility="false"/>
                    <keyFrame time="0.6" visibility="true"/>
                </part>
                <shader node="neon" parameterName="lightControl">
                    <keyFrame time="0.0" values="0" />
                    <keyFrame time="1.0" values="7" />
                </shader>
            </animation>
            <controls triggerNode="lightTrigger" posAction="ACTIVATE_HANDTOOL" posText="On" negText="Off" />
        </animatedObject>
        <animatedObject saveId="porte01" >
            <animation duration="1">
                <part node="porte01">
                    <keyFrame time="0.0" rotation="0 180 0"/>
                    <keyFrame time="1.0" rotation="0 69 0"/>
                </part>
            </animation>
            <controls triggerNode="trigger01" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="porte01" template="metalDoorsLoop" />
                <posEnd linkNode="porte01" template="metalDoorsOpen" />
                <negEnd linkNode="porte01" template="metalDoorsClose" />
            </sounds>
        </animatedObject>
        <animatedObject saveId="porte02" >
            <animation duration="1">
                <part node="porte02">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 130 0"/>
                </part>
            </animation>
            <controls triggerNode="trigger02" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="porte02" template="metalDoorsLoop" />
                <posEnd linkNode="porte02" template="metalDoorsOpen" />
                <negEnd linkNode="porte02" template="metalDoorsClose" />
            </sounds>
        </animatedObject>
        <animatedObject saveId="porte03" >
            <animation duration="1">
                <part node="porte03">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 111 0"/>
                </part>
            </animation>
            <controls triggerNode="trigger03" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="porte03" template="metalDoorsLoop" />
                <posEnd linkNode="porte03" template="metalDoorsOpen" />
                <negEnd linkNode="porte03" template="metalDoorsClose" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <triggerMarkers>
        <triggerMarker node="wardrobeTriggerMarker" filename="$data/shared/assets/marker/markerIconWardrobe.i3d"/>
    </triggerMarkers>

    <lights>
    </lights>

    <wardrobe triggerNode="wardrobeTrigger"/>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="lightTrigger" node="0>6|0|0"/>
        <i3dMapping id="neon" node="0>6|0|1"/>
        <i3dMapping id="realLightsLow" node="0>6|0|2"/>
        <i3dMapping id="realLightsHigh" node="0>6|0|3"/>
        <i3dMapping id="porte01" node="0>6|1|0"/>
        <i3dMapping id="trigger01" node="0>6|1|1"/>
        <i3dMapping id="porte02" node="0>6|2|0"/>
        <i3dMapping id="trigger02" node="0>6|2|1"/>
        <i3dMapping id="porte03" node="0>6|3|0"/>
        <i3dMapping id="trigger03" node="0>6|3|1"/>
        <i3dMapping id="wardrobeTriggerMarker" node="0>8|0"/>
        <i3dMapping id="wardrobeTrigger" node="0>8|1"/>
        <i3dMapping id="teleportNode" node="0>9"/>
    </i3dMappings>
</placeable>
