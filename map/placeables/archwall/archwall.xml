<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_archwall</name>
        <functions>
            <function>$l10n_function_garage</function>
        </functions>
        <image>$data/placeables/meridian/archwall/store_archwall.dds</image>
        <price>110000</price>
        <dailyUpkeep>100</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>MERIDIAN</brand>
        <species>PLACEABLE</species>
        <category>sheds</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>sheds</tab>
        </brush>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>632320</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>150528</indexBufferMemoryUsage>
        <textureMemoryUsage>1048576</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/meridian/archwall/archwall.i3d</filename>
    </base>


    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="lightSwitch" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
    </dynamicallyLoadedParts>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/garageCeilingLamp.xml" linkNode="linkedLights01" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/garageCeilingLamp.xml" linkNode="linkedLights02" groupIndex="1" />

        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger">
            <sounds>
                <toggle template="lizardFloodLight" innerRadius="50" outerRadius="100" volumeScale="0.2"/>
            </sounds>
        </group>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <animatedObjects>
        <animatedObject saveId="door01" >
            <animation duration="4.5">
                <clip rootNode="archwallGate01_lod0" name="archwallGate09Source" filename="$data/placeables/meridian/archwall/archwallGateAnim.i3d" />
                <part node="occluderMeshDoor">
                    <keyFrame time="0"    visibility="true" />
                    <keyFrame time="0.01" visibility="false" />
                </part>
                <part node="archwallGateRotate">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="-900 0 0"/>
                </part>
            </animation>

            <controls triggerNode="doorTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving  template="rollingGarageDoor"     linkNodeOffset="0 0 12" innerRadius="5" outerRadius="25"/>
                <posEnd  template="slidingGateMetalOpen"  linkNodeOffset="0 0 12"/>
                <negEnd  template="slidingGateMetalClose" linkNodeOffset="0 0 12"/>
            </sounds>
        </animatedObject>
    </animatedObjects>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>1|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="testAreaStart01" node="0>2|0" />
        <i3dMapping id="testAreaEnd01" node="0>2|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="realLightsLow" node="0>4|0|0" />
        <i3dMapping id="realLightsHigh" node="0>4|0|1" />
        <i3dMapping id="linkedLights01" node="0>4|1|0" />
        <i3dMapping id="linkedLights02" node="0>4|1|1" />
        <i3dMapping id="lightSwitch" node="0>4|2" />
        <i3dMapping id="lightTrigger" node="0>4|3" />
        <i3dMapping id="archwallGateRotate" node="0>5|0" />
        <i3dMapping id="archwallGate" node="0>5|1" />
        <i3dMapping id="archwallGate01Rot" node="0>5|1|0" />
        <i3dMapping id="archwallGate01_lod0" node="0>5|1|0|0" />
        <i3dMapping id="doorTrigger" node="0>5|2" />
        <i3dMapping id="occluderMeshDoor" node="0>9" />
    </i3dMappings>
</placeable>
