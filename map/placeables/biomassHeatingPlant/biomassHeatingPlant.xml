<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_Bio Mass Plant</name>
        <functions>
            <function>$l10n_function_sellingPoint</function>
        </functions>
        <image>$data/placeables/brandless/productionPointsGeneric/biomassHeatingPlant/store_biomassHeatingPlant.png</image>
        <price>120000</price>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>

    </storeData>

    <base>
        <filename>$data/placeables/brandless/productionPointsGeneric/biomassHeatingPlant/biomassHeatingPlant.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="largeImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarker"         filename="$data/shared/assets/marker/markerIconUnload.i3d"           adjustToGround="true" />
        <triggerMarker node="woodSellPlayerTriggerMarker" filename="$data/shared/assets/marker/markerIconExclamationMark.i3d" adjustToGround="true" />
    </triggerMarkers>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="data/placeables/brandless/productionPointsGeneric/biomassHeatingPlant/biomassHeatingPlantProps.i3d" node="0" linkNode="props"/>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCoverWideGrid.i3d"             node="0" linkNode="unloadTriggerLinkNode" rotation="0 90 0"/>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d"                                                     node="1" linkNode="smokeBig" shaderParameterName="colorAlpha" shaderParameter="1 1 1 1"/>
    </dynamicallyLoadedParts>

    <sellingStation appearsOnStats="true" node="sellingStation" supportsExtension="false">
        <unloadTrigger exactFillRootNode="exactFillNode" fillTypes="WOODCHIPS STRAW WOOD" aiNode="unloadTriggerAINode" />
        <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="10000" fillTypes="WOOD WOODCHIPS STRAW ROUNDBALE_WOOD ROUNDBALE SQUAREBALE" aiNode="unloadTriggerAINode" />
        <woodTrigger triggerNode="woodTrigger" activationTriggerNode="woodSellPlayerTrigger" fillTypes="WOOD WOODCHIPS STRAW ROUNDBALE_WOOD ROUNDBALE SQUAREBALE" aiNode="unloadTriggerAINode" />

        <fillType name="WOODCHIPS" priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="STRAW"     priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <sounds>
            <idle template="placeableSmallIdleGeneric" volumeScale="20.0" innerRadius="20" outerRadius="58" />
            <active template="biomassPlantActive" volumeScale="10.00" pitchScale="-0.6" innerRadius="20" outerRadius="58"  />
        </sounds>
    </sellingStation>

    <i3dMappings>
        <i3dMapping id="biomassHeatingPlant" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="interior" node="0>6|1|0" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="exactFillNode" node="0>8|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|2" />
        <i3dMapping id="unloadTriggerLinkNode" node="0>8|3" />
        <i3dMapping id="woodSellPlayerTriggerMarker" node="0>8|4" />
        <i3dMapping id="woodSellPlayerTrigger" node="0>8|5" />
        <i3dMapping id="baleTrigger" node="0>8|6" />
        <i3dMapping id="woodTrigger" node="0>8|7" />
        <i3dMapping id="smokeBig" node="0>9|1" />
        <i3dMapping id="props" node="0>9|2" />
    </i3dMappings>
</placeable>
