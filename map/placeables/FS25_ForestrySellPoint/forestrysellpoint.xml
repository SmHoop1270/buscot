<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_sellingStation_forestrySellPoint</name>
		<functions>
            <function>$l10n_function_sellingPoint</function>
        </functions>
        <image>store_forestrysellpoint.dds</image>
        <price>2000</price>
        <dailyUpkeep>1</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sellingPoints</category>
		<brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>
        <vertexBufferMemoryUsage>330240</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>68096</indexBufferMemoryUsage>
        <textureMemoryUsage>1245184</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>forestrysellpoint.i3d</filename>
		<canBeDeleted>true</canBeDeleted>
		<canBeRenamed>true</canBeRenamed>
		<boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <paintAreas>
            <paintArea startNode="paintAreaStart01" heightNode="paintAreaHeight01" groundType="GRAVEL" widthNode="paintAreaWidth01"/>
        </paintAreas>
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="gravel"/>
        </levelAreas>
    </leveling>

    <!-- <indoorAreas> -->
        <!-- <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/> -->
    <!-- </indoorAreas> -->
	<indoorAreas/>
	
    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <!-- <sellingStation node="sellingStation" supportsExtension="false" incomeName="soldWood">
        <woodTrigger fillTypes="WOOD" triggerNode="woodTrigger" activationTriggerNode="woodSellTrigger"/>
        <unloadTrigger exactFillRootNode="woodTrigger2" fillTypes="WOODCHIPS" aiNode="sellingStationAINode" />
        
        <fillType name="WOODCHIPS" priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
		<palletTrigger fillTypes="WOOD" triggerNode="unloadTriggerContainer" priceScale="1.5"/>
    </sellingStation> -->

    <sellingStation appearsOnStats="true" litersForFullPriceDrop="200000" fullPriceRecoverHours="48" supportsExtension="false" incomeName="soldWood">
        <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="WOOD" priceScale="1.5"/>
		<woodTrigger fillTypes="WOOD" aiNode="unloadTriggerAINode" triggerNode="woodTrigger" activationTriggerNode="woodSellActivationTrigger" priceScale="1.5"/>
		<woodTrigger fillTypes="WOOD" aiNode="unloadTriggerAINode2" triggerNode="woodTrigger2" activationTriggerNode="woodSellActivationTrigger2" priceScale="1.5"/>
		<palletTrigger fillTypes="WOOD" triggerNode="unloadTriggerContainer" priceScale="1.5"/>
	</sellingStation>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker"/>
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="unloadTriggerMarker2" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="warningStripes_woodTrigger"/>
		<triggerMarker node="woodSellActivationTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconExclamationMark.i3d"/>
		<triggerMarker node="woodSellActivationTriggerMarker2" adjustToGround="true" filename="$data/shared/assets/marker/markerIconExclamationMark.i3d"/>
    </triggerMarkers>

    <infoTrigger triggerNode="infoTrigger" />

