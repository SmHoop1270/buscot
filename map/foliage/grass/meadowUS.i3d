    <!-- Round 11: dedicated material for LOD0's dormant/small state only, so the
         muted washed-out recolor applies just to greenSmall (the winter knockback
         state) and not to grassMiddle/harvestReady/cut/roller, which previously
         all shared meadowUS_mat (materialId 1) and so were incorrectly muted
         year-round, including summer. -->
    <Material name="grassPureSmallLOD0_mat" materialId="15" customShaderId="4" customShaderVariation="SEASONAL">
      <CustomParameter name="seasonalTintIntensity" value="0.0 0.0 0.0"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="57"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


