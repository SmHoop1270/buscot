        <i3dMapping id="palletArea1End" node="0>14|1|0" />
        <i3dMapping id="palletArea2Start" node="0>14|2" />
        <i3dMapping id="palletArea2End" node="0>14|2|0" />
        <i3dMapping id="markerFood" node="0>15|0" />
        <i3dMapping id="warningStripes01" node="0>15|1|0" />
        <i3dMapping id="markerAnimals" node="0>16" />
        <i3dMapping id="loadingTrigger" node="0>17" />
