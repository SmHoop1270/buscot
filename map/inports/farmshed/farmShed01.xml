<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="chickenHusbandry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_bricksShedChicken</name>
        <functions>
            <function>$l10n_function_animalPenChicken</function>
        </functions>
        <image>$data/placeables/mapEU/brandless/buildings/farmSheds/store_farmShed01.png</image>
        <price>25000</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>placeable</type>
            <category>animals</category>
            <tab>chickens</tab>
        </brush>
        <vertexBufferMemoryUsage>347648</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>88832</indexBufferMemoryUsage>
        <textureMemoryUsage>3670016</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>$data/placeables/mapEU/brandless/buildings/farmSheds/farmShed01.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place        template="medImp" />
            <placeLayered template="chickenLayer" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="dirt"/>
        </levelAreas>

        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="grass" />
            <paintArea startNode="paintAreaStart02" widthNode="paintAreaWidth02" heightNode="paintAreaHeight02" groundType="grass" />
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <foliageAreas>
        <foliageArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" decoFoliage="grassShort" />
        <foliageArea startNode="paintAreaStart02" widthNode="paintAreaWidth02" heightNode="paintAreaHeight02" decoFoliage="grassShort" />
    </foliageAreas>

    <triggerMarkers>
        <triggerMarker node="markerFood"       adjustToGround="true" filename="$data/shared/assets/marker/markerIconFood.i3d"/>
        <triggerMarker node="markerAnimals"    adjustToGround="true" filename="$data/shared/assets/marker/markerIconAnimals.i3d"/>
        <triggerMarker node="warningStripes01"/>
    </triggerMarkers>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="CHICKEN" teleportNode="teleportNode"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger" />

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/mapEU/brandless/buildings/farmSheds/props01.i3d"                 node="0|1" linkNode="props" />
        <dynamicallyLoadedPart filename="$data/placeables/mapEU/brandless/buildings/farmSheds/props01.i3d"                 node="0|2" linkNode="props" />
        <dynamicallyLoadedPart filename="$data/placeables/mapEU/brandless/buildings/farmSheds/farmShed01InteriorProps.i3d" node="0"   linkNode="props" />
        <dynamicallyLoadedPart filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d"                         node="0"   linkNode="lightSwitch01" />
        <dynamicallyLoadedPart filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d"                         node="0"   linkNode="lightSwitch02" />
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d"                                   node="0"   linkNode="smoke01" shaderParameterName="colorAlpha" shaderParameter="0.25 0.25 0.25 0.15" position="0 -0.3 0"/>
        <dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d"                                   node="0"   linkNode="smoke02" shaderParameterName="colorAlpha" shaderParameter="0.25 0.25 0.25 0.15" position="0 -0.3 0"/>
    </dynamicallyLoadedParts>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight04.xml" linkNode="industrialLight04_01" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight04.xml" linkNode="industrialLight04_02" groupIndex="2" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight04.xml" linkNode="industrialLight04_04" groupIndex="3" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight04.xml" linkNode="industrialLight04_03" groupIndex="3" />

        <realLights>
            <low>
                <light node="realLightsLow01" groupIndex="1"/>
                <light node="realLightsLow02" groupIndex="2"/>
                <light node="realLightsLow03" groupIndex="3"/>
            </low>
            <high>
                <light node="realLightsHigh01" groupIndex="1"/>
                <light node="realLightsHigh02" groupIndex="2"/>
                <light node="realLightsHigh03" groupIndex="3"/>
            </high>
        </realLights>

        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger01"/>
        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger02"/>
        <group weatherRequiredFlags="NIGHT"/>
    </lights>

    <husbandry saveId="Animals_CHICKEN" hasStatistics="false">
        <storage node="storage" fillTypes="WATER" isExtension="false">
            <capacity fillType="WATER" capacity="0" />
        </storage>

        <unloadingStation supportsExtension="false" hideFromPricesMenu="true" />

        <loadingStation supportsExtension="false" />

        <animals type="CHICKEN" maxNumAnimals="20" maxNumVisualAnimals="12">
            <navigation rootNode="navigationRootNode" filename="$data/placeables/mapEU/brandless/buildings/farmSheds/farmShed01_navigationMesh.i3d" />
            <loadingTrigger node="loadingTrigger" />
        </animals>

        <food capacity="750" >
            <foodPlane node="foodPlane" minY="0.042" maxY="0.165" changeVisibility="true" defaultFillType="WHEAT"/>
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <foodPlaces>
                <foodPlace node="foodPlace1"/>
            </foodPlaces>
        </food>

        <pallets>
            <palletSpawner fillTypes="EGG" maxNumPallets="8">
                <palletTrigger node="palletTrigger" />
                <spawnPlaces>
                    <spawnPlace startNode="palletArea1Start" endNode="palletArea1End" />
                    <spawnPlace startNode="palletArea2Start" endNode="palletArea2End" />
                </spawnPlaces>
            </palletSpawner>
        </pallets>
    </husbandry>

    <animatedObjects>
        <animatedObject saveId="door01">
            <animation duration="3">
                <part node="door01">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 150 0"/>
                </part>
            </animation>
            <controls triggerNode="doorTrigger01" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
            <sounds>
                <moving linkNode="door01" template="woodDoorSqueaksMedium" pitchScale="1.0" volumeScale="0.7" innerRadius="5" outerRadius="25" fadeIn="0.4" />
                <negEnd linkNode="door01" template="woodDoorClose02" pitchScale="1.0" volumeScale="1.4" innerRadius="5" outerRadius="25" />
                <posEnd linkNode="door01" template="plasticDoorOpen" pitchScale="0.9" volumeScale="0.6" />
            </sounds>
        </animatedObject>
        <animatedObject saveId="door02">
            <animation duration="3">
                <part node="door02">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 150 0"/>
                </part>
            </animation>
            <controls triggerNode="doorTrigger02" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor"/>
            <sounds>
                <moving linkNode="door02" template="woodDoorSqueaksMedium"  pitchScale="1.0" volumeScale="0.7" innerRadius="5" outerRadius="25" fadeIn="0.4" />
                <negEnd linkNode="door02" template="woodDoorClose02" pitchScale="1.0" volumeScale="1.4" innerRadius="5" outerRadius="25" />
                <posEnd linkNode="door02" template="plasticDoorOpen" pitchScale="0.9" volumeScale="0.6" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>1|0" />
        <i3dMapping id="paintAreaWidth01" node="0>1|0|0" />
