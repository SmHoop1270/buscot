        <i3dMapping id="industrialLight04_01" node="0>18|1|0" />
        <i3dMapping id="industrialLight04_02" node="0>18|1|1" />
        <i3dMapping id="industrialLight04_03" node="0>18|1|2" />
        <i3dMapping id="industrialLight04_04" node="0>18|1|3" />
