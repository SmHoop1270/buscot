        <i3dMapping id="paintAreaStart02" node="0>1|1" />
        <i3dMapping id="paintAreaWidth02" node="0>1|1|0" />
        <i3dMapping id="paintAreaHeight02" node="0>1|1|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>2|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>2|1|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="infoTrigger" node="0>5" />
        <i3dMapping id="smoke01" node="0>6|0" />
        <i3dMapping id="smoke02" node="0>6|1" />
        <i3dMapping id="props" node="0>7|0|0|8" />
        <i3dMapping id="door01" node="0>9|0" />
        <i3dMapping id="door02" node="0>9|1" />
        <i3dMapping id="doorTrigger01" node="0>9|3" />
        <i3dMapping id="doorTrigger02" node="0>9|4" />
        <i3dMapping id="teleportNode" node="0>10" />
        <i3dMapping id="exactFillRootNodeFood" node="0>11|0" />
        <i3dMapping id="foodPlace1" node="0>11|1|0" />
        <i3dMapping id="foodPlane" node="0>11|2|0" />
