<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="newFence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_fenceUS_01</name>
        <functions>
            <function>$l10n_function_decoration</function>
        </functions>
        <image>$data/placeables/brandless/fences/US/fence01/store_fence01.png</image>
        <price>150</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>fences</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>

        <brush>
            <type>newFence</type>
            <category>decoration</category>
            <tab>newFences</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/placeables/brandless/fences/US/fence01/fence01.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <sounds>
            <place template="fenceWoodImp" />
            <destroy template="destroyFence" />
        </sounds>
    </placement>

    <fence>
        <segment id="SEGMENT" class="FenceSegment" maxVerticalAngle="45">
            <poles>
                <pole node="pole01" radius="0.0"/>
            </poles>
            <panels maxScale="1.2">
                <panel node="panel01" length="2"/>
            </panels>
        </segment>

        <segment id="GATE_TALL" class="FenceGate" maxVerticalAngle="45">
            <gate node="gateTall" length="1.69">
            </gate>
        </segment>

        <segment id="GATE_1_5m" class="FenceGate" maxVerticalAngle="45">
            <gate node="gate1_5m" length="1.63">
                <animatedObject saveId="door02" >
                    <animation duration="1.5">
                        <part node="gate1_5mOpenA">
                            <keyFrame time="0.1" rotation="0 0 0"/>
                            <keyFrame time="1.2" rotation="0 90 0"/>
                        </part>
                    </animation>
                    <controls triggerNode="gate1_5mTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
                    <sounds>
                        <moving linkNode="gate1_5m" template="fenceLoop" />
                        <posEnd linkNode="gate1_5m" template="fenceOpen" />
                        <negEnd linkNode="gate1_5m" template="fenceClose" />
                    </sounds>
                </animatedObject>
            </gate>
        </segment>

        <segment id="GATE_2m" class="FenceGate" maxVerticalAngle="45">
            <gate node="gate2m" length="2.22">
                <animatedObject saveId="door02" >
                    <animation duration="1.5">
                        <part node="gate2mOpenA">
                            <keyFrame time="0.1" rotation="0 0 0"/>
                            <keyFrame time="1.2" rotation="0 -90 0"/>
                        </part>
                        <part node="gate2mOpenB">
                            <keyFrame time="0.1" rotation="0 0 0"/>
                            <keyFrame time="1.2" rotation="0 90 0"/>
                        </part>
                    </animation>
                    <controls triggerNode="gate2mTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
                    <sounds>
                        <moving linkNode="gate2m" template="fenceLoop" />
                        <posEnd linkNode="gate2m" template="fenceOpen" />
                        <negEnd linkNode="gate2m" template="fenceClose" />
                    </sounds>
                </animatedObject>
            </gate>
        </segment>

        <segment id="GATE_4m" class="FenceGate" maxVerticalAngle="45">
            <gate node="gate4m" length="4.13">
                <animatedObject saveId="door03" >
                    <animation duration="1.5">
                        <part node="gate4mOpenA">
                            <keyFrame time="0.1" rotation="0 0 0"/>
                            <keyFrame time="1.2" rotation="0 -90 0"/>
                        </part>
                        <part node="gate4mOpenB">
                            <keyFrame time="0.1" rotation="0 0 0"/>
                            <keyFrame time="1.2" rotation="0 90 0"/>
                        </part>
                    </animation>
                    <controls triggerNode="gate4mTrigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
                    <sounds>
                        <moving linkNode="gate4m" template="fenceLoop" />
                        <posEnd linkNode="gate4m" template="fenceOpen" />
                        <negEnd linkNode="gate4m" template="fenceClose" />
                    </sounds>
                </animatedObject>
            </gate>
        </segment>

    </fence>


    <i3dMappings>
        <i3dMapping id="gateTall" node="0>0" />
        <i3dMapping id="gate1_5m" node="0>1" />
        <i3dMapping id="gate1_5mOpenA" node="0>1|0" />
        <i3dMapping id="gate1_5mTrigger" node="0>1|3" />
        <i3dMapping id="gate1_5mSound" node="0>1|4" />
        <i3dMapping id="gate2m" node="0>2" />
        <i3dMapping id="gate2mOpenA" node="0>2|0" />
        <i3dMapping id="gate2mOpenB" node="0>2|1" />
        <i3dMapping id="gate2mTrigger" node="0>2|4" />
        <i3dMapping id="gate2mSound" node="0>2|5" />
        <i3dMapping id="gate4m" node="0>3" />
        <i3dMapping id="gate4mOpenA" node="0>3|0" />
        <i3dMapping id="gate4mOpenB" node="0>3|1" />
        <i3dMapping id="gate4mTrigger" node="0>3|4" />
        <i3dMapping id="gate4mSound" node="0>3|5" />
        <i3dMapping id="pole01" node="1>0" />
        <i3dMapping id="panel01" node="2>0" />
    </i3dMappings>
</placeable>
