<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sheepHusbandry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
            <en>Sheep_Pasture_Wool</en></name>
        <image>map/inports/FS25_OpenPastures_Sheep/store_sheepSmallAutoWater.dds</image>
        <price>35000</price>
        <functions>
            <function>$l10n_function_animalPenSheep</function>
            <function>$l10n_function_adjustableMeadow</function>
        </functions>
        <lifetime>1000</lifetime>
        <dailyUpkeep>75</dailyUpkeep>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>animalpens</category>
        <brush>
            <type>husbandry</type>
            <category>animals</category>
            <tab>sheeps</tab>
        </brush>

        <storeIconRendering>
            <settings cameraXRot="-20" cameraYRot="50" advancedBoundingBox="true"/>
        </storeIconRendering>
    </storeData>
    <base>
        <filename>map/inports/FS25_OpenPastures_Sheep/i3d/sheepSmall.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>
    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
            <placeLayered template="sheepLayer"/>
        </sounds>
    </placement>
    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>
    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="grass"/>
        </levelAreas>
    </leveling>
    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>
    <foliageAreas/>
    <triggerMarkers>
        <triggerMarker node="markerWater" filename="$data/shared/assets/marker/markerIconWater.i3d"/>
        <triggerMarker node="markerFood" filename="$data/shared/assets/marker/markerIconFood.i3d"/>
        <triggerMarker node="markerAnimals" filename="$data/shared/assets/marker/markerIconAnimals.i3d"/>
        <triggerMarker node="markerBales" filename="$data/shared/assets/marker/markerIconBales.i3d"/>
        <triggerMarker node="markerPallet" filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
    </triggerMarkers>
    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
    </tipOcclusionUpdateAreas>
    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
        </updateAreas>
    </ai>
    <hotspots>
        <hotspot type="SHEEP" teleportNode="teleportNode"/>
    </hotspots>
    <infoTrigger triggerNode="infoTrigger"/>
    <husbandry saveId="Animals_SHEEP" hasStatistics="false">
        <pallets>
            <palletSpawner fillTypes="WOOL GOATMILK" maxNumPallets="8">
                <palletTrigger node="palletTrigger" />
                <spawnPlaces>
                    <spawnPlace startNode="palletArea1Start" endNode="palletArea1End" />
                    <spawnPlace startNode="palletArea2Start" endNode="palletArea2End" />
                </spawnPlaces>
            </palletSpawner>
        </pallets>
        <animals type="SHEEP" sqmPerAnimal="226" maxNumAnimals="600" maxNumVisualAnimals="60">
            <navigation rootNode="navigationRootNode"/>
            <loadingTrigger node="loadingTrigger"/>
        </animals>
        <food capacity="1125000">
            <foodPlane node="foodPlane" minY="0.045" maxY="0.4" changeVisibility="true" defaultFillType="forage"/>
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood"/>
            <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="200"/>
        </food>
        <water automaticWaterSupply="true">
            <waterPlaces>
                <waterPlace node="waterPlace1"/>
            </waterPlaces>
        </water>
        <fence xmlFilename="map/inports/FS25_OpenPastures_Sheep/xml/sheepFence.xml">
            <sections>
                <section segmentId="SEGMENT" customizable="true">
                    <node node="fence1Node1"/>
                    <node node="fence1Node2"/>
                    <node node="fence1Node3"/>
                    <node node="fence1Node4"/>
                    <node node="fence1Node5"/>
                    <node node="fence1Node6"/>
                </section>
            </sections>
        </fence>
        <meadow>
            <fruitType name="GRASS" eatableStartGrowthState="greenMiddle" eatableEndGrowthState="harvestReady" eatenGrowthState="greenSmall"/>
            <fruitType name="MEADOW" eatableStartGrowthState="greenMiddle" eatableEndGrowthState="harvestReady" eatenGrowthState="greenSmall"/>
            <createTask weedState="0">
                <fruit type="MEADOW" growthState="greenSmall"/>
                <ground type="NONE"/>
                <terrainGroundType name="grass"/>
            </createTask>
            <clearTask>
                <fruit type="UNKNOWN" growthState="0"/>
                <ground type="NONE"/>
                <terrainGroundType name="dirt"/>
                <polygon>
                    <node node="clearAreaPoint1"/>
                    <node node="clearAreaPoint2"/>
                    <node node="clearAreaPoint3"/>
                    <node node="clearAreaPoint4"/>
                    <node node="clearAreaPoint5"/>
                    <node node="clearAreaPoint6"/>
                </polygon>
            </clearTask>
        </meadow>
    </husbandry>
    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="waterFill" filename="map/inports/FS25_OpenPastures_Sheep/i3d/waterFill.i3d" />
    </dynamicallyLoadedParts>
    <colorConfigurations>
        <material slotName="mainColor_mat" />
        <colorConfiguration color="RUDOLFHOERMANN_RED"/>
        <colorConfiguration color="RUDOLFHOERMANN_GREEN"/>
        <colorConfiguration color="RUDOLFHOERMANN_BEIGE"/>
