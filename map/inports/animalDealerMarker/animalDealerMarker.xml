<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Animal Dealer</name>
        <image>$data/store/store_empty.png</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
    </storeData>

    <base>
        <filename>$mapdir$/map/inports/animalDealerMarker/animalDealerMarker.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <placement/>

    <clearAreas/>

    <leveling/>

    <indoorAreas/>

    <tipOcclusionUpdateAreas/>

    <ai>
        <updateAreas/>
    </ai>

    <hotspots>
        <hotspot type="SHOP_ANIMAL" linkNode="teleportNode" teleportNode="teleportNode" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="teleportNode" node="0>0" />
    </i3dMappings>
</placeable>
