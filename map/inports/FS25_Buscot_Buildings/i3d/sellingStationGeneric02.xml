<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Henry and Son Millers</name>
        <image>map/textures/FS25_Buscot_Buildings_store_grainsellpoint.dds</image>
        <price>1</price>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <dailyUpkeep>0</dailyUpkeep>
        <species>placeable</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>

    </storeData>

    <base>
        <filename>map/inports/FS25_Buscot_Buildings/i3d/grainsellpoint.i3d</filename>
	</base>

    <placement useRandomYRotation="false" useManualYRotation="true" />

    <clearAreas></clearAreas>

    <leveling></leveling>

    <indoorAreas></indoorAreas>

    <ai>
        <updateAreas/>
        <splines>
            <spline node="aiSpline" />
        </splines>
    </ai>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadMarkerTrailer" teleportNode="unloadMarkerTrailer" />
    </hotspots>



    <triggerMarkers>
        <triggerMarker node="unloadMarkerTrailer" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
    </triggerMarkers>

    <sellingStation supportsExtension="false" litersForFullPriceDrop="200000" fullPriceRecoverHours="48">
        <unloadTrigger exactFillRootNode="unloadNodeTrailer" fillTypeCategories="SELLINGSTATION_FIELDFRUITS" priceScale="1" aiNode="unloadNodeAI"/>
        <palletTrigger triggerNode="palletTrigger" fillTypeCategories="SELLINGSTATION_FIELDFRUITS" priceScale="1" />
        <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="10000" fillTypeCategories="SELLINGSTATION_FIELDFRUITS" priceScale="1" />
		
        <fillType name="WHEAT"               priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="BARLEY"              priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="OAT"                 priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="CANOLA"              priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="SORGHUM"             priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="SUNFLOWER"           priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="SOYBEAN"             priceScale="1" supportsGreatDemand="true" disablePriceDrop="true" />
        <fillType name="MAIZE"               priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />

    </sellingStation>

